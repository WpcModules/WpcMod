{
	"schemaVersion": 1,
	"id": "wpcmod",
	"version": "${version}",
	"name": "WpcMod",
	"description": "Hypixel SkyBlock QOL Mod for Fabric",
	"authors": [
		"Wapic"
	],
	"contributors": [
		"ValsCSGO",
		"AZRockiesFan"
	],
	"contact": {
		"homepage": "https://github.com/WpcModules/WpcMod",
		"sources": "https://github.com/WpcModules/WpcMod",
		"issues": "https://github.com/WpcModules/WpcMod/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/wpcmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"rei_client": [
			"net.wapic.wpcmod.compat.ReiCompatibility"
		],
		"main": [
			{
				"value": "net.wapic.wpcmod.WpcMod",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"wpcmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_version}",
		"fabric-language-kotlin": ">=${fabric_kotlin_version}"
	},
	"accessWidener": "wpcmod.accesswidener",
	"custom": {
		"firmament:hide_from_modlist": true
	}
}