{
	"schemaVersion": 1,
	"id": "wpcmod",
	"version": "${version}",
	"name": "WpcMod",
	"description": "Hypixel SkyBlock QOL Mod for Fabric",
	"authors": [
		"Wapic"
	],
	"contributors": [
		"ValsCSGO",
		"AZRockiesFan"
	],
	"contact": {
		"homepage": "https://wpcmod.wapic.net/",
		"sources": "https://github.com/WpcModules/WpcMod",
		"issues": "https://github.com/WpcModules/WpcMod/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/wpcmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"rei_client": [
			"net.wapic.wpcmod.compat.ReiCompatibility"
		],
		"main": [
			{
				"value": "net.wapic.wpcmod.WpcMod",
				"adapter": "kotlin"
			}
        ]
	},
	"mixins": [
		"wpcmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": ">=0.138.4+1.21.10",
		"fabric-language-kotlin": ">=1.13.8+kotlin.2.3.0"
	},
	"custom": {
		"firmament:hide_from_modlist": true
	}
}